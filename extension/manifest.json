{
  "manifest_version": 3,
  "name": "Tab Zen",
  "version": "0.1.0",
  "description": "Tidy your tabs into beautiful, AI-grouped sessions.",
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "background": {
    "service_worker": "src/background/index.ts",
    "type": "module"
  },
  "permissions": ["tabs", "storage"]
}
